	partition copilot_usage_user = m
		mode: import
		source =
				let
				    Origen = Sql.Database(SqlEndpoint, Lakehouse),
				    Datos = Origen{[Schema = "dbo", Item = "copilot_usage_user"]}[Data],
				    // Días entre la última actividad y el refresco del informe; nulo si nunca lo ha usado
				    #"Añadidos días sin actividad" = Table.AddColumn(Datos, "days_inactive", each if [last_activity_date] = null then null else Duration.Days(Date.From([report_refresh_date]) - Date.From([last_activity_date])), Int64.Type),
				    // Activo = actividad en los 28 días anteriores al refresco (misma regla que la medida Activos 28d)
				    #"Añadido activo 28d" = Table.AddColumn(#"Añadidos días sin actividad", "is_active_28d", each if [days_inactive] <> null and [days_inactive] < 28 then 1 else 0, Int64.Type),
				    // Segmento por días sin actividad
				    #"Añadido segmento" = Table.AddColumn(#"Añadido activo 28d", "segment", each
				        if [days_inactive] = null then "Nunca usado"
				        else if [days_inactive] < 7 then "Activo semanal"
				        else if [days_inactive] < 28 then "Activo mensual"
				        else if [days_inactive] < 60 then "En riesgo"
				        else "Dormido", type text),
				    #"Añadido orden de segmento" = Table.AddColumn(#"Añadido segmento", "segment_order", each
				        if [segment] = "Activo semanal" then 1
				        else if [segment] = "Activo mensual" then 2
				        else if [segment] = "En riesgo" then 3
				        else if [segment] = "Dormido" then 4
				        else 5, Int64.Type)
				in
				    #"Añadido orden de segmento"

